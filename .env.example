# Copy this to ".env" and adjust if needed:  cp .env.example .env
# Prospecta: prefer  node platform/scripts/init-env.mjs  — it creates .env from this file and
# fills every secret marked <gerado> with a strong random value (existing values are kept).
#
# This local setup binds the scraper to 127.0.0.1 only, so NO API key is required.
# (The scraper image has no built-in authentication — localhost binding is the boundary.)

SCRAPER_BASE_URL=http://localhost:8080

# Only needed if you later expose the scraper beyond localhost behind an auth proxy
# (e.g. Caddy/nginx that checks an X-API-Key header). Leave blank for local use.
SCRAPER_API_KEY=

# ───────────────────────── Prospecta (platform/) ─────────────────────────
# Nunca commite o arquivo .env. Todos os segredos abaixo são gerados localmente.

# URL pública da plataforma. No computador: http://localhost:3000.
# Na VPS (compose.prod.yaml): https://SEU_DOMINIO, junto com COOKIE_SECURE=true.
APP_BASE_URL=http://localhost:3000
# true somente se a plataforma for servida via HTTPS (cookies Secure).
COOKIE_SECURE=false

# Só na VPS (passo a passo em platform/docs/DEPLOY-VPS.md). No computador, deixe em branco.
# Para ativar o HTTPS em todos os comandos "docker compose" do servidor, adicione também a linha:
#   COMPOSE_FILE=docker-compose.yml:compose.prod.yaml
# Domínio apontado para o IP da VPS e e-mail que recebe os avisos do certificado (Let's Encrypt)
DOMAIN=
ACME_EMAIL=
# Só em servidor que já usa Traefik + Docker Swarm (platform/deploy/prospecta-stack.yaml):
# pasta do projeto no servidor, rede e certresolver do Traefik existente
PROSPECTA_DIR=
TRAEFIK_NETWORK=
TRAEFIK_CERTRESOLVER=

# Banco de dados (container postgres, rede interna)
POSTGRES_USER=prospecta
POSTGRES_DB=prospecta
POSTGRES_PASSWORD=<gerado>

# Filas e rate limit (container valkey, rede interna)
VALKEY_PASSWORD=<gerado>

# Criptografia de segredos em repouso (tokens do WhatsApp etc.) — 32 bytes em base64
APP_ENCRYPTION_KEY=<gerado>
# Assinatura interna de sessões/CSRF
SESSION_SECRET=<gerado>
# Token exigido UMA vez na tela /setup para criar o primeiro administrador.
# Depois que existir um usuário, a rota de setup fica desativada.
ADMIN_BOOTSTRAP_TOKEN=<gerado>

# E-mail transacional (recuperação de senha). Padrão: Mailpit local em http://localhost:8025
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Prospecta <no-reply@prospecta.local>
# usuário:senha da interface do Mailpit
MAILPIT_UI_AUTH=<gerado>

# Fontes de busca habilitadas (padrão: só o Google Maps). Para reativar o OpenStreetMap: GOOGLE_MAPS_SCRAPER,OSM_OVERPASS
SEARCH_SOURCES=GOOGLE_MAPS_SCRAPER
# Mapa visual do Google (opcional). Sem chave, ou se o Google recusar/esgotar a cota, a plataforma usa o
# mapa do OpenStreetMap automaticamente. Veja platform/docs/MANUTENCAO.md (Mapa do Google).
#   GOOGLE_MAPS_API_KEY: chave da Maps JavaScript API restrita por site (http://localhost:3000/*)
#   GOOGLE_MAPS_MAP_ID: ID de mapa (Gerenciamento de mapas); vazio usa DEMO_MAP_ID, para testes
#   GOOGLE_GEOCODING_API_KEY: chave separada, restrita só à Geocoding API, para localizar cidades pelo Google
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_GEOCODING_API_KEY=
# Fontes de descoberta
# Adaptador opcional do Google Maps Scraper (raspagem viola os Termos do Google: use com moderação)
GMAPS_SCRAPER_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Geocodificador reserva, usado quando o Nominatim não responde (também usa dados do OpenStreetMap)
PHOTON_URL=https://photon.komoot.io
# Identificação honesta do robô nas requisições (exigida pela política do Nominatim)
HTTP_USER_AGENT=ProspectaBot/0.1 (+local; contato via administrador)

# WhatsApp via WuzAPI (rede interna; nunca publicar na internet)
WUZAPI_ADMIN_TOKEN=<gerado>
# exatamente 32 caracteres
WUZAPI_GLOBAL_ENCRYPTION_KEY=<gerado32>
# mínimo 32 caracteres
WUZAPI_GLOBAL_HMAC_KEY=<gerado>

# Destinos internos liberados para o crawler, separados por vírgula (só para testes, ex.: demo.prospecta.test).
# Vazio = endereços privados e internos sempre bloqueados.
CRAWLER_ALLOW_HOSTS=
LOG_LEVEL=info
