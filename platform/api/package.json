{
  "name": "@prospecta/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST, regras de negócio e workers da plataforma Prospecta",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.dev src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env.dev src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/cli/seed.ts",
    "cli": "node dist/cli/index.js"
  },
  "dependencies": {
    "@crawlee/cheerio": "3.18.2",
    "@crawlee/playwright": "3.18.2",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.3.17",
    "cheerio": "1.2.0",
    "chrome-launcher": "1.2.2",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.8.2",
    "libphonenumber-js": "1.13.15",
    "lighthouse": "13.5.0",
    "nodemailer": "10.1.7",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playwright": "1.64.1",
    "prisma": "7.10.1",
    "robots-parser": "3.0.1",
    "sanitize-html": "2.18.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
