}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  title          String
  description    String?
  type           String       @default("TODO")
  status         TaskStatus   @default(OPEN)
  priority       Priority     @default(MEDIUM)
  dueAt          DateTime?    @map("due_at")
  remindAt       DateTime?    @map("remind_at")
  remindedAt     DateTime?    @map("reminded_at")
  assigneeId     String?      @map("assignee_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([assigneeId, status])
  @@index([companyId])
  @@map("tasks")
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  WHATSAPP
  STAGE_CHANGE
  TASK
  DEAL
  IMPORT
  ENRICHMENT
  AUDIT
  FIELD_CHANGE
  CONSENT
  SYSTEM
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  type           ActivityType
  title          String
  body           String?
  /// duração de ligações/reuniões, resultado, diff de campos etc.
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([dealId])
  @@map("activities")
}

model Note {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  authorId       String?      @map("author_id") @db.Uuid
  body           String
  pinned         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("notes")
}

// ───────────────────────────── Mensagens e consentimento ─────────────────────────────

enum MessagingProvider {
  WUZAPI
  WHATSAPP_CLOUD
}

enum MessagingAccountStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  LOGGED_OUT
  ERROR
}

model MessagingAccount {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  provider         MessagingProvider
  name             String
  externalUserId   String?                @map("external_user_id")
  /// token do provedor cifrado com AES-256-GCM (APP_ENCRYPTION_KEY)
  tokenEncrypted   String?                @map("token_encrypted")
  /// chave HMAC dos webhooks cifrada
  hmacKeyEncrypted String?                @map("hmac_key_encrypted")
  status           MessagingAccountStatus @default(DISCONNECTED)
  phoneJid         String?                @map("phone_jid")
  settings         Json                   @default("{}")
  lastError        String?                @map("last_error")
  lastStatusAt     DateTime?              @map("last_status_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  webhookEvents    WebhookEvent[]

  @@index([organizationId])
  @@map("messaging_accounts")
}

model Conversation {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  messagingAccountId String           @map("messaging_account_id") @db.Uuid
  companyId          String?          @map("company_id") @db.Uuid
  channel            String           @default("WHATSAPP")
  externalChatId     String           @map("external_chat_id")
  contactPhone       String           @map("contact_phone")
  contactName        String?          @map("contact_name")
  lastMessageAt      DateTime?        @map("last_message_at")
  lastInboundAt      DateTime?        @map("last_inbound_at")
  unreadCount        Int              @default(0) @map("unread_count")
  status             String           @default("OPEN")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messagingAccount   MessagingAccount @relation(fields: [messagingAccountId], references: [id], onDelete: Cascade)
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  messages           Message[]

  @@unique([messagingAccountId, externalChatId])
  @@index([organizationId, lastMessageAt])
  @@index([companyId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  QUEUED
  SENT
  DELIVERED
  READ
  RECEIVED
  FAILED
  BLOCKED
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  externalId     String?          @map("external_id")
  /// evita envio duplicado (cliente informa) e eventos repetidos do webhook
  idempotencyKey String?          @unique @map("idempotency_key")
  body           String
  type           String           @default("text")
  status         MessageStatus
  error          String?
  templateId     String?          @map("template_id") @db.Uuid
  sentById       String?          @map("sent_by_id") @db.Uuid
  approvedById   String?          @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?        @map("approved_at")
  sentAt         DateTime?        @map("sent_at")
  deliveredAt    DateTime?        @map("delivered_at")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  template       MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentBy         User?            @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  approvedBy     User?            @relation("MessageApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([organizationId, status])
  @@map("messages")
}

model MessageTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  body           String
  category       String       @default("ATENDIMENTO")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([organizationId, name])
  @@map("message_templates")
}

/// Eventos brutos recebidos por webhook (idempotência e rastreabilidade)
model WebhookEvent {
  id                 String            @id @default(uuid()) @db.Uuid
  messagingAccountId String?           @map("messaging_account_id") @db.Uuid
  provider           MessagingProvider
  eventType          String            @map("event_type")
  dedupeKey          String            @unique @map("dedupe_key")
  signatureValid     Boolean           @map("signature_valid")
  payload            Json
  processedAt        DateTime?         @map("processed_at")
  error              String?
  receivedAt         DateTime          @default(now()) @map("received_at")
  messagingAccount   MessagingAccount? @relation(fields: [messagingAccountId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@map("webhook_events")
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum LegalBasis {
  CONSENT
  LEGITIMATE_INTEREST
  CONTRACT
  CUSTOMER_INITIATED
}

model ContactConsent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String?       @map("company_id") @db.Uuid
  channel        String        @default("WHATSAPP")
  /// valor normalizado (E.164 para telefone, minúsculas para e-mail)
  contactValue   String        @map("contact_value")
  status         ConsentStatus
  legalBasis     LegalBasis    @map("legal_basis")
  /// como a autorização foi obtida (ex.: formulário do site, pedido em ligação)
  source         String
  evidence       String?
  grantedAt      DateTime?     @map("granted_at")
  revokedAt      DateTime?     @map("revoked_at")
  recordedById   String?       @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recordedBy     User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId, channel, contactValue, createdAt])
  @@map("contact_consents")
}

model SuppressionEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  channel        String       @default("WHATSAPP")
  value          String
  reason         String
  source         String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel, value])
  @@map("suppression_list")
}

// ───────────────────────────── Auditoria do sistema e caches ─────────────────────────────

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String
  entityType     String?       @map("entity_type")
  entityId       String?       @map("entity_id")
  ip             String?
  userAgent      String?       @map("user_agent")
  /// metadados sem segredos (diff de campos, motivo…)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model GeocodeCache {
  id        String   @id @default(uuid()) @db.Uuid
  query     String   @unique
  latitude  Float
  longitude Float
  label     String
  raw       Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("geocode_cache")
}

// ───────────────────── Fontes públicas e gratuitas (Central de integrações) ─────────────────────

/// Cache global de respostas de fontes públicas (IBGE, Comex Stat…): estatística agregada, sem dado pessoal.
model PublicDataCache {
  id              String   @id @default(uuid()) @db.Uuid
  source          String
  /// recurso consultado (ex.: "regional:4128104")
  key             String
  payload         Json
  /// período de referência do dado (ano, mês), quando a fonte informa
  referencePeriod String?  @map("reference_period")
  fetchedAt       DateTime @default(now()) @map("fetched_at")
  expiresAt       DateTime @map("expires_at")

  @@unique([source, key])
  @@map("public_data_cache")
}

/// Cada execução de uma integração pública (consulta, sincronização, teste): saúde, falhas e volume. Sem chave nem dado pessoal.
model IntegrationRun {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  source         String
  /// company | regional | sync | health | import
  operation      String
  ok             Boolean
  /// executada com a fonte simulada (sem rede)
  mock           Boolean  @default(false)
  httpStatus     Int?     @map("http_status")
  records        Int      @default(0)
  durationMs     Int?     @map("duration_ms")
  errorCode      String?  @map("error_code")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@index([organizationId, source, createdAt])
  @@index([companyId, source])
  @@map("integration_runs")
}

/// Importação de arquivo público (Receita, CAGED, CVM) com checkpoint: a retomada continua da última linha gravada.
model PublicImportRun {
  id            String    @id @default(uuid()) @db.Uuid
  source        String
  /// empresas | estabelecimentos | socios | cnaes | naturezas | municipios | motivos | caged_mov | cvm_cadastro | cvm_dfp
  kind          String
  /// nome do arquivo (sem a pasta)
  file          String
  fileSize      BigInt?   @map("file_size")
  filters       Json      @default("{}")
  /// RUNNING | COMPLETED | FAILED | CANCELLED
  status        String
  linesRead     Int       @default(0) @map("lines_read")
  linesImported Int       @default(0) @map("lines_imported")
  /// última linha de dados gravada com sucesso
  checkpoint    Int       @default(0)
  error         String?
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([source, kind, file])
  @@map("public_import_runs")
}

/// Contratações publicadas no PNCP (catálogo global). O vínculo com os segmentos de cada conta é feito na leitura.
model PublicOpportunity {
  id               String    @id @default(uuid()) @db.Uuid
  source           String    @default("pncp")
  /// numeroControlePNCP
  controlNumber    String    @map("control_number")
  buyerCnpj        String?   @map("buyer_cnpj")
  buyerName        String?   @map("buyer_name")
  unitName         String?   @map("unit_name")
  uf               String?
  city             String?
  cityIbge         String?   @map("city_ibge")
  modalityId       Int?      @map("modality_id")
  modality         String?
  object           String
  objectFolded     String    @map("object_folded")
  /// valor total estimado informado pelo órgão (pode ser sigiloso ou ausente)
  estimatedValue   Float?    @map("estimated_value")
  status           String?
  publishedAt      DateTime? @map("published_at")
  proposalOpensAt  DateTime? @map("proposal_opens_at")
  proposalClosesAt DateTime? @map("proposal_closes_at")
  url              String?
  fetchedAt        DateTime  @default(now()) @map("fetched_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([source, controlNumber])
  @@index([uf, proposalClosesAt])
  @@index([cityIbge, publishedAt])
  @@map("public_opportunities")
}

/// Registros públicos ligados a uma empresa pelo CNPJ (Portal da Transparência). Informativo: não é juízo de valor.
model CompanyPublicRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  source         String
  /// CEIS | CNEP | CONTRATO_FEDERAL
  kind           String
  externalId     String       @map("external_id")
  cnpj           String
  agency         String?
  recordType     String?      @map("record_type")
  description    String?
  status         String?
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")
  value          Float?
  url            String?
  fetchedAt      DateTime     @default(now()) @map("fetched_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, companyId, source, kind, externalId])
  @@index([companyId])
  @@map("company_public_records")
}

/// Receita Federal: dados abertos do CNPJ (recorte local importado). Empresa = raiz do CNPJ (8 dígitos).
model RfEmpresa {
  cnpjBasico       String   @id @map("cnpj_basico") @db.Char(8)
  razaoSocial      String   @map("razao_social")
  naturezaJuridica String?  @map("natureza_juridica")
  capitalSocial    Float?   @map("capital_social")
  /// 00 não informado | 01 micro empresa | 03 empresa de pequeno porte | 05 demais
  porte            String?
  importedAt       DateTime @default(now()) @map("imported_at")

  @@map("rf_empresas")
}

/// Receita Federal: estabelecimento (matriz ou filial). Sem e-mail completo: só o domínio, para cruzar com o site.
model RfEstabelecimento {
  cnpj             String    @id @db.Char(14)
  cnpjBasico       String    @map("cnpj_basico") @db.Char(8)
  /// 1 matriz | 2 filial
  matrizFilial     String?   @map("matriz_filial")
  nomeFantasia     String?   @map("nome_fantasia")
  nomeFolded       String?   @map("nome_folded")
  /// 01 nula | 02 ativa | 03 suspensa | 04 inapta | 08 baixada
  situacao         String?
  dataSituacao     DateTime? @map("data_situacao") @db.Date
  motivoSituacao   String?   @map("motivo_situacao")
  dataInicio       DateTime? @map("data_inicio") @db.Date
  cnaePrincipal    String?   @map("cnae_principal")
  cnaesSecundarios String[]  @default([]) @map("cnaes_secundarios")
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  cep              String?
  uf               String?
  /// código de município da Receita (tabela própria, diferente do IBGE)
  municipioCodigo  String?   @map("municipio_codigo")
  /// DDD + número, só dígitos
  telefones        String[]  @default([])
  emailDominio     String?   @map("email_dominio")
  importedAt       DateTime  @default(now()) @map("imported_at")

  @@index([cnpjBasico])
  @@index([uf, municipioCodigo])
  @@index([cep])
  @@index([emailDominio])
  @@index([telefones], type: Gin)
  @@map("rf_estabelecimentos")
}

/// Receita Federal: quadro societário resumido. Só a quantidade (nomes e CPF não são importados).
model RfSociosResumo {
  cnpjBasico String @id @map("cnpj_basico") @db.Char(8)
  quantidade Int

  @@map("rf_socios_resumo")
}

/// Receita Federal: tabelas de código (cnae, natureza, municipio, motivo).
model RfCodigo {
  tipo      String
  codigo    String
  descricao String

  @@id([tipo, codigo])
  @@map("rf_codigos")
}

/// Novo CAGED (MTE) agregado por competência, município e seção CNAE. Nenhum dado de trabalhador é guardado.
model LaborStat {
  id          String @id @default(uuid()) @db.Uuid
  /// arquivo de origem (CAGEDMOV…): permite refazer a importação de um mês sem duplicar
  sourceFile  String @map("source_file")
  /// competência AAAAMM
  period      String @db.Char(6)
  /// município IBGE com 6 dígitos (sem o verificador), como publicado no CAGED
  cityCode    String @map("city_code") @db.Char(6)
  /// seção CNAE 2.0 (A a U)
  section     String
  hires       Int    @default(0)
  separations Int    @default(0)
  balance     Int    @default(0)

  @@unique([sourceFile, period, cityCode, section])
  @@index([cityCode, period])
  @@map("labor_stats")
}

/// CVM: companhias abertas (cadastro).
model CvmCompany {
  cnpj         String    @id @db.Char(14)
  name         String
  tradeName    String?   @map("trade_name")
  status       String?
  sector       String?
  cvmCode      String?   @map("cvm_code")
  registeredAt DateTime? @map("registered_at") @db.Date
  importedAt   DateTime  @default(now()) @map("imported_at")

  @@map("cvm_companies")
}

/// CVM: contas principais das demonstrações financeiras padronizadas (DFP), exercício mais recente de cada arquivo.
model CvmFinancial {
  id            String   @id @default(uuid()) @db.Uuid
  cnpj          String   @db.Char(14)
  year          Int
  /// BPA | BPP | DRE
  statement     String
  consolidated  Boolean
  accountCode   String   @map("account_code")
  accountName   String   @map("account_name")
  /// valor como publicado (multiplicar pela escala)
  value         Float
  /// MIL | UNIDADE
  scale         String
  referenceDate DateTime @map("reference_date") @db.Date
  version       Int      @default(1)

  @@unique([cnpj, year, statement, consolidated, accountCode])
  @@index([cnpj])
  @@map("cvm_financials")
}
